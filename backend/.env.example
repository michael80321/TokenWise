# Railway 會自動注入 DATABASE_URL，不需要手動填
DATABASE_URL=postgresql://user:password@host:5432/railway

# API 安全設定
API_SECRET_KEY=change-me-to-a-random-32-char-string

# 環境
NODE_ENV=production
PORT=3000

# Auth
JWT_SECRET=change-me-to-a-random-64-char-string

# Email (Resend — https://resend.com，免費方案 100 封/天)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# RevenueCat webhook secret（RevenueCat Dashboard → Webhooks → Secret）
RC_WEBHOOK_SECRET=your-webhook-secret

# Cron job secret（Railway Cron 呼叫 /api/cron/check-prices 時帶此 header）
# x-cron-secret: your-cron-secret
CRON_SECRET=change-me-random-string

# 每日 LLM token 熔斷預算（USD），超過後自動停用 LLM 功能直到隔日
# 目前後端不呼叫 LLM，此為里程碑 4 準備
DAILY_LLM_BUDGET_USD=5.00
